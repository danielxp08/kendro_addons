<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Images as ir.attachment with external URLs (Unsplash) -->

    <!-- Property 1: Casa del Lago -->
    <record id="demo_property_1_image_1" model="ir.attachment">
        <field name="name">Casa del Lago - Image 1</field>
        <field name="type_url">url</field>
        <field name="url">https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=800</field>
        <field name="external">True</field>
        <field name="mimetype">image/jpeg</field>
    </record>
    <record id="demo_property_1_image_2" model="ir.attachment">
        <field name="name">Casa del Lago - Image 2</field>
        <field name="type_url">url</field>
