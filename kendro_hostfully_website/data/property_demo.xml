    <!-- Properties Demo Data -->

    <record id="demo_property_1" model="kendro.property">
        <field name="name">Casa del Lago</field>
        <field name="description">Beautiful lake house with stunning views. Perfect for families looking for a peaceful retreat. Features a spacious living area, fully equipped kitchen, and a private dock.</field>
        <field name="active">True</field>
        <field name="sequence">1</field>
        <field name="price">150.00</field>
        <field name="currency_id" ref="base.USD"/>
        <field name="location">Lake Tahoe, California</field>
        <field name="bedrooms">3</field>
        <field name="bathrooms">2</field>
        <field name="max_guests">6</field>
        <field name="image_ids" eval="[(6, 0, [ref('kendro_hostfully_website.demo_property_1_image_1'), ref('kendro_hostfully_website.demo_property_1_image_2')])]"/>
    </record>

    <record id="demo_property_2" model="kendro.property">
        <field name="name">Departamento Centro</field>
        <field name="description">Modern downtown apartment with city views. Walking distance to restaurants, shops, and public transport. Perfect for business travelers or couples.</field>
        <field name="active">True</field>
        <field name="sequence">2</field>
        <field name="price">95.00</field>
        <field name="currency_id" ref="base.USD"/>
        <field name="location">Downtown Miami, Florida</field>
        <field name="bedrooms">1</field>
        <field name="bathrooms">1</field>
        <field name="max_guests">2</field>
        <field name="image_ids" eval="[(6, 0, [ref('kendro_hostfully_website.demo_property_2_image_1'), ref('kendro_hostfully_website.demo_property_2_image_2')])]"/>
    </record>

    <record id="demo_property_3" model="kendro.property">
        <field name="name">Cabaña Montaña</field>
        <field name="description">Cozy mountain cabin with fireplace and hot tub. Surrounded by hiking trails and nature. Perfect for adventure seekers and romantic getaways.</field>
        <field name="active">True</field>
        <field name="sequence">3</field>
        <field name="price">180.00</field>
        <field name="currency_id" ref="base.USD"/>
        <field name="location">Aspen, Colorado</field>
        <field name="bedrooms">2</field>
        <field name="bathrooms">2</field>
        <field name="max_guests">4</field>
        <field name="image_ids" eval="[(6, 0, [ref('kendro_hostfully_website.demo_property_3_image_1'), ref('kendro_hostfully_website.demo_property_3_image_2')])]"/>
    </record>

</odoo>